{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "app", "region": "asia-south1" } }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": { "source": ".", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "uploads", "data.db*", "push-vapid.json", "native", "public", ".firebase", "firebase-debug.log", "firestore-debug.log"] }
}
